{
  "name": "tablegrid",
  "private": true,
  "version": "0.1.1",
  "license": "AGPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "vite-dev": "vite",
    "build-frontend": "tsc -b && vite build",
    "build": "tauri build",
    "build:mac": "tauri build --target aarch64-apple-darwin",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "start": "tauri dev",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "postinstall": "node scripts/setup-blame.mjs",
    "fmt:rust": "cd src-tauri && cargo fmt",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets",
    "test:rust": "cd src-tauri && cargo test --lib"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.42.0",
    "monaco-editor": "^0.54.0",
    "monaco-sql-languages": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
